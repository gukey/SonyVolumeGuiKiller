<Window x:Class="SonyVolumeGuiKillerPcManager.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="索尼电视连接图解与项目说明" Width="960" Height="850" MinWidth="800" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#F5F8FC">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="连接图解与项目说明" FontSize="26" FontWeight="Bold" Foreground="#172033"/>
            <TextBlock Text="三项分别是：两种端口 + 一组六位配对码。不是三个调试端口。" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#667085"/>
        </StackPanel>
        <TabControl Grid.Row="1" Background="White" BorderBrush="#D6DCE8" Padding="16">
            <TabItem Header="  三项填写图解  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,12,12,12">
                        <TextBlock Text="先在电视上打开：设置 → 开发者选项 → 无线调试" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="电脑和电视连接同一局域网。菜单名称可能略有不同。以下是示意图，数字只作示例，请填写电视当前显示的值。" Margin="0,8,0,18" TextWrapping="Wrap" Foreground="#667085"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#172033" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="电视页面 A · 无线调试" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="无线调试                         已开启" Margin="0,18,0,14" Foreground="#D0D5DD"/>
                                    <TextBlock Text="IP 地址与端口" Foreground="#D0D5DD"/>
                                    <TextBlock Margin="0,8,0,12" FontSize="19" Foreground="White"><Run Text="192.168.1.100:"/><Run Text="40567" Foreground="#5EEAD4" FontWeight="Bold"/></TextBlock>
                                    <Border Background="#115E59" CornerRadius="6" Padding="10"><TextBlock Text="③ 调试端口填 40567" Foreground="White" TextWrapping="Wrap"/></Border>
                                    <TextBlock Text="↓ 再选择「使用配对码配对设备」" Margin="0,18,0,0" Foreground="#D0D5DD" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#172033" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="电视页面 B · 配对弹窗" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Wi-Fi 配对码" Margin="0,18,0,6" Foreground="#D0D5DD"/>
                                    <TextBlock Text="123456" Foreground="#D8B4FE" FontSize="26" FontWeight="Bold"/>
                                    <TextBlock Text="② 六位配对码填 123456" Foreground="#D8B4FE" Margin="0,6,0,14" TextWrapping="Wrap"/>
                                    <TextBlock Text="IP 地址与端口" Foreground="#D0D5DD"/>
                                    <TextBlock Margin="0,8,0,12" FontSize="19" Foreground="White"><Run Text="192.168.1.100:"/><Run Text="37123" Foreground="#93C5FD" FontWeight="Bold"/></TextBlock>
                                    <Border Background="#1E40AF" CornerRadius="6" Padding="10"><TextBlock Text="① 配对端口填 37123" Foreground="White" TextWrapping="Wrap"/></Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="↓ 对应填入电脑工具的三个输入框" FontSize="17" FontWeight="Bold" Margin="0,20,0,12"/>
                        <UniformGrid Columns="3">
                            <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="① 配对端口" Foreground="#1D4ED8"/><TextBlock Text="37123" FontSize="24" FontWeight="Bold"/><TextBlock Text="来自页面 B" Margin="0,6,0,0" Foreground="#667085"/></StackPanel></Border>
                            <Border Background="#FAF5FF" CornerRadius="8" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="② 六位配对码" Foreground="#7E22CE"/><TextBlock Text="123456" FontSize="24" FontWeight="Bold"/><TextBlock Text="来自页面 B" Margin="0,6,0,0" Foreground="#667085"/></StackPanel></Border>
                            <Border Background="#F0FDFA" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="③ 调试端口" Foreground="#0F766E"/><TextBlock Text="40567" FontSize="24" FontWeight="Bold"/><TextBlock Text="来自页面 A" Margin="0,6,0,0" Foreground="#667085"/></StackPanel></Border>
                        </UniformGrid>
                        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="25" Text="1. 先记下页面 A 的调试端口，再打开页面 B。&#x0a;2. 保持配对弹窗打开，输入当前配对端口和六位配对码（开头的 0 也要保留）。&#x0a;3. 在左侧填写电视 IP，不带冒号或端口；点击左侧“连接电视”。&#x0a;4. 配对失败时重新打开配对弹窗，更新配对端口和配对码后再试。"/>
                        <Border Margin="0,16,0,0" Background="#FFF7ED" CornerRadius="8" Padding="14"><TextBlock TextWrapping="Wrap" LineHeight="24" Text="已经配对：①②一起留空，③填当前调试端口。&#x0a;已开启固定网络 ADB：①②留空，③填 5555；首次连接时在电视授权弹窗中允许电脑调试。&#x0a;配对端口用于首次认证，调试端口用于安装和诊断，两者不要混填。无线调试端口可能变化；5555 只有实际开启后才能使用。"/></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="  这个项目做什么  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,12,12,12">
                        <Image Source="pack://application:,,,/SonyVolumeGuiKillerPcManager;component/Resources/project-overview.png" Stretch="Uniform"/>
                        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="26" Text="使用顺序：连接电视 → 备份现有 APK → 安装/更新 → 验证状态。&#x0a;EXE 负责配对、安装、授权和诊断；APK 留在电视上执行守护，完成配置后电脑可以关闭。&#x0a;自动 5555 辅助应用用于配置网络 ADB；需要按电视实际系统完成授权。"/>
                        <Border Background="#FFF7ED" CornerRadius="8" Padding="14" Margin="0,16,0,0"><TextBlock TextWrapping="Wrap" LineHeight="24" Text="适用于兼容的索尼 Android TV 固件。无障碍服务和电视本机 ADB 授权需要有效。&#x0a;项目不是音量锁定工具，也不会把电视静音。若固件接口变化或授权失效，应先检查状态，不能保证所有型号都兼容。&#x0a;旧版 APK 签名不同时不能直接覆盖；请先备份授权数据，不要直接卸载。"/></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Button Grid.Row="2" Content="关闭" Width="110" HorizontalAlignment="Right" Margin="0,16,0,0" Click="CloseButton_Click"/>
    </Grid>
</Window>

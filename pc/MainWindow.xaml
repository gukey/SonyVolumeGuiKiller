<Window x:Class="SonyVolumeGuiKillerPcManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SonyVolumeGuiKillerPcManager.Models"
        Title="索尼电视音量弹窗管理工具"
        Icon="pack://application:,,,/SonyVolumeGuiKillerPcManager;component/Resources/ok.png"
        Width="1420"
        Height="940"
        MinWidth="1260"
        MinHeight="860"
        WindowStartupLocation="CenterScreen"
        Background="#F5F8FC">
    <Window.Resources>
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#ECF5FF" Offset="0.55"/>
            <GradientStop Color="#F8FBFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SuccessPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5FFF8" Offset="0"/>
            <GradientStop Color="#E9FFF0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WarningPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF8EF" Offset="0"/>
            <GradientStop Color="#FFF2DE" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="InfoPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F9FF" Offset="0"/>
            <GradientStop Color="#EAF2FF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F4F7FB"/>
            <Setter Property="Foreground" Value="#2C3A56"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="ActionGreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#16A34A"/>
        </Style>

        <Style x:Key="ActionBlueButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
        </Style>

        <Style x:Key="ActionPurpleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#7C3AED"/>
        </Style>

        <Style x:Key="ActionAmberButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EA580C"/>
        </Style>

        <Style x:Key="ActionTealButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0891B2"/>
        </Style>

        <Style x:Key="ActionGrayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#475467"/>
        </Style>

        <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ValueTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <Style x:Key="ValueContentStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Background="{StaticResource HeroBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Border Width="38" Height="38" CornerRadius="12" Background="#EAF2FF" Margin="0,0,10,0">
                            <Image Source="pack://application:,,,/SonyVolumeGuiKillerPcManager;component/Resources/ok.png" Stretch="Uniform" Margin="6"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="索尼电视管理工具"
                                       Style="{StaticResource CardTitle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Sony BRAVIA Android TV 应用与设备管理"
                                       Margin="0,6,0,0"
                                       Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,18,0,0"
                        CornerRadius="16"
                        Background="White"
                        Padding="14">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="设备连接"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"/>
                            <Border x:Name="SidebarConnectionBadge"
                                    Style="{StaticResource Badge}"
                                    Background="#94A3B8"
                                    DockPanel.Dock="Right">
                                <TextBlock x:Name="SidebarConnectionBadgeText"
                                           Style="{StaticResource BadgeTextStyle}"
                                           Text="未连接"/>
                            </Border>
                        </DockPanel>
                        <TextBox x:Name="SidebarIpTextBox"
                                 Margin="0,14,0,0"
                                 Padding="8,4"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource InkBrush}"
                                 Background="#F8FAFC"
                                 BorderBrush="#BFDBFE"
                                 ToolTip="填写电视当前的局域网 IP 地址，不带端口。"
                                 Text=""
                                 TextChanged="SidebarIpTextBox_TextChanged"/>
                        <TextBlock Text="Sony BRAVIA Android TV"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource MutedText}"/>
                        <Button x:Name="SidebarConnectButton"
                                Margin="0,16,0,0"
                                Content="连接电视"
                                Click="ConnectButton_Click"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <Button x:Name="DashboardNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Background="#EAF2FF"
                            Foreground="#1D4ED8"
                            Click="DashboardNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D2;" FontSize="16"/>
                            <TextBlock Text="  设备状态"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AppManagerNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="AppManagerNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71D;" FontSize="16"/>
                            <TextBlock Text="  应用管理"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="InstallButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" FontSize="16"/>
                            <TextBlock Text="  安装更新"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="ViewLogsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" FontSize="16"/>
                            <TextBlock Text="  日志"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="HelpButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="16"/>
                            <TextBlock Text="  设置"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SidebarHelpButton"
                            Style="{StaticResource NavButtonStyle}"
                            Background="#FFF2E8"
                            Foreground="#C2410C"
                            Click="HelpButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE897;" FontSize="16"/>
                            <TextBlock Text="  说明"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3"
                        Margin="0,18,0,0"
                        Style="{StaticResource Card}"
                        Background="White"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="ADB 工具信息"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock x:Name="AdbVersionText"
                                   Margin="0,12,0,0"
                                   Style="{StaticResource MutedText}"
                                   Text="ADB 版本：检查中"/>
                        <TextBlock x:Name="AdbDirectoryText"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource MutedText}"
                                   Text="工具目录：tools"/>
                        <TextBlock x:Name="AdbPathText"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource MutedText}"
                                   Text="ADB 路径：tools\adb.exe"
                                   TextWrapping="Wrap"/>
                        <Border x:Name="AdbServiceBadge"
                                Style="{StaticResource Badge}"
                                Margin="0,14,0,0"
                                Background="#16A34A">
                            <TextBlock x:Name="AdbServiceBadgeText"
                                       Style="{StaticResource BadgeTextStyle}"
                                       Text="ADB 服务可用"/>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="4"
                           Margin="0,18,0,0"
                           Style="{StaticResource MutedText}"
                           Text="内置 ADB，不依赖系统 PATH。"/>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="320"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource HeroBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="连接电视"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="0"/>
                                <ColumnDefinition Width="0"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="电视 IP" Visibility="Collapsed" Style="{StaticResource MutedText}" Margin="0,0,12,6"/>
                            <TextBlock Grid.Column="1" Text="① 配对端口" Style="{StaticResource MutedText}" Margin="0,0,12,6"/>
                            <TextBlock Grid.Column="2" Text="② 六位配对码" Style="{StaticResource MutedText}" Margin="0,0,12,6"/>
                            <TextBlock Grid.Column="3" Text="③ 调试端口" Style="{StaticResource MutedText}" Margin="0,0,12,6"/>
                            <TextBox x:Name="TvIpTextBox" Visibility="Collapsed"
                                     Grid.Row="1"
                                     Text=""
                                     TextChanged="TvIpTextBox_TextChanged"
                                     Margin="0,0,12,0"/>
                            <TextBox x:Name="PairingPortTextBox" ToolTip="电视“使用配对码配对设备”弹窗中，IP 地址冒号后的端口。"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,0,12,0"/>
                            <TextBox x:Name="PairingCodeTextBox" ToolTip="同一配对弹窗显示的六位数字；不是端口号。"
                                     Grid.Row="1"
                                     Grid.Column="2"
                                     Margin="0,0,12,0"/>
                            <TextBox x:Name="DebugPortTextBox" ToolTip="无线调试主页面的 IP 地址与端口，取冒号后的数字；已启用固定网络 ADB 时可填 5555。"
                                     Grid.Row="1"
                                     Grid.Column="3"
                                     Margin="0,0,12,0"/>
                            <Button x:Name="ConnectButton" Visibility="Collapsed"
                                    Grid.Row="1"
                                    Grid.Column="4"
                                    Margin="0"
                                    Content="连接电视"
                                    Click="ConnectButton_Click"/>

                        </Grid>
                        <DockPanel Margin="0,10,0,0"><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消" Width="56" IsEnabled="False" Click="CancelButton_Click" Margin="8,0,0,0" Padding="6" FontSize="12" Background="#475467"/><Button Content="这三项怎么填？查看图解" Click="HelpButton_Click" Margin="0" Padding="8,6" FontSize="12" Background="#E7EFFF" Foreground="#1D4ED8" HorizontalAlignment="Left"/></DockPanel>
<TextBlock x:Name="BusyText"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource MutedText}"
                                   Text="等待操作"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="18,0"
                            Style="{StaticResource Card}"
                            Background="{StaticResource SuccessPanelBrush}"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Visibility="Collapsed" Width="44" Height="44" CornerRadius="14" Background="#16A34A" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="22"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0">
                                <TextBlock x:Name="HealthHeadlineText" TextWrapping="Wrap"
                                           Foreground="#15803D"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Text="设备状态待检测"/>
                                <TextBlock x:Name="HealthSubText"
                                           Margin="0,6,0,0"
                                           Foreground="#3F5F4E"
                                           Text="连接后可查看 APK、无障碍和守护状态。"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Margin="0,0,18,0"
                            Style="{StaticResource Card}"
                            Background="{StaticResource InfoPanelBrush}">
                        <StackPanel>
                            <TextBlock Text="设备健康度"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"/>
                            <TextBlock x:Name="HealthScoreText"
                                       Margin="0,10,0,0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#2563EB"
                                       Text="0 / 100"/>
                            <ProgressBar x:Name="HealthScoreBar"
                                         Margin="0,10,0,0"
                                         Height="8"
                                         Maximum="100"
                                         Value="0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"
                            Style="{StaticResource Card}"
                            Background="{StaticResource WarningPanelBrush}">
                        <StackPanel>
                            <TextBlock Text="最近检测"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"/>
                            <TextBlock x:Name="LastCheckText"
                                       Margin="0,10,0,0"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#C2410C"
                                       Text="尚未检测"/>
                            <TextBlock x:Name="DeviceStateHintText"
                                       Margin="0,8,0,0"
                                       Foreground="#7C2D12"
                                       Text="等待连接电视"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,16,0,16">
                <Grid x:Name="DashboardView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="设备信息" Style="{StaticResource CardTitle}"/>
                                    <Border x:Name="DeviceStateBadge"
                                            Style="{StaticResource Badge}"
                                            Background="#94A3B8"
                                            DockPanel.Dock="Right">
                                        <TextBlock x:Name="DeviceStateBadgeText"
                                                   Style="{StaticResource BadgeTextStyle}"
                                                   Text="未连接"/>
                                    </Border>
                                </DockPanel>
                                <UniformGrid Margin="0,18,0,0" Columns="2">
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="ADB 状态" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="DeviceStateText" Style="{StaticResource ValueContentStyle}" Text="未连接"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="TV 网络 ADB" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="TcpPortText" Style="{StaticResource ValueContentStyle}" Text="未检测"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="APK 路径" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="PackagePathText" Style="{StaticResource ValueContentStyle}" Text="-" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="run-as" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="RunAsText" Style="{StaticResource ValueContentStyle}" Text="-"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="ADB Key" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="KeyText" Style="{StaticResource ValueContentStyle}" Text="-"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="本机 ADB 路径" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="LocalAdbPathText" Style="{StaticResource ValueContentStyle}" Text="tools\adb.exe" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="守护状态" Style="{StaticResource CardTitle}"/>
                                    <Border x:Name="GuardBadge"
                                            Style="{StaticResource Badge}"
                                            Background="#94A3B8"
                                            DockPanel.Dock="Right">
                                        <TextBlock x:Name="GuardBadgeText"
                                                   Style="{StaticResource BadgeTextStyle}"
                                                   Text="待检测"/>
                                    </Border>
                                </DockPanel>
                                <UniformGrid Margin="0,18,0,0" Columns="2">
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="mVolumeController" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="ControllerText" Style="{StaticResource ValueContentStyle}" Text="未检测" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="无障碍状态" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="AccessibilityText" Style="{StaticResource ValueContentStyle}" Text="未检测"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Margin="0,4,0,0" Text="dumpsys audio 解析" Style="{StaticResource ValueTitleStyle}"/>
                                <TextBox x:Name="ControllerRawTextBox"
                                         Margin="0,10,0,0"
                                         Height="90"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="快捷操作" Style="{StaticResource CardTitle}"/>
                                <Button x:Name="InstallButton"
                                        Margin="0,18,0,0"
                                        Style="{StaticResource ActionGreenButton}"
                                        Click="InstallButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" FontSize="16"/>
                                        <TextBlock Text="  一键安装"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Margin="0,10,0,10"
                                           Text="自动安装两个 App、写入授权 Key、启用无障碍，并恢复 5555。详细步骤看下方日志。"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource MutedText}"/>
                                <Button x:Name="VerifyButton"
                                        Style="{StaticResource ActionAmberButton}"
                                        Click="VerifyButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D2;" FontSize="16"/>
                                        <TextBlock Text="  验证状态 / 诊断"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ViewLogsButton"
                                        Style="{StaticResource ActionBlueButton}"
                                        Click="ViewLogsButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" FontSize="16"/>
                                        <TextBlock Text="  查看日志"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BackupButton"
                                        Style="{StaticResource ActionTealButton}"
                                        Click="BackupButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7C3;" FontSize="16"/>
                                        <TextBlock Text="  备份电视 APK"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ClearLogsButton"
                                        Style="{StaticResource ActionGrayButton}"
                                        Click="ClearLogsButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" FontSize="16"/>
                                        <TextBlock Text="  清空日志"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="HelpButton"
                                        Background="#FFF2E8"
                                        Foreground="#C2410C"
                                        Click="HelpButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE897;" FontSize="16"/>
                                        <TextBlock Text="  说明"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="APK 状态" Style="{StaticResource CardTitle}"/>
                                    <Border x:Name="PackageBadge"
                                            Style="{StaticResource Badge}"
                                            Background="#94A3B8"
                                            DockPanel.Dock="Right">
                                        <TextBlock x:Name="PackageBadgeText"
                                                   Style="{StaticResource BadgeTextStyle}"
                                                   Text="未检测"/>
                                    </Border>
                                </DockPanel>
                                <UniformGrid Margin="0,18,0,0" Columns="2">
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="安装状态" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="PackageStateText" Style="{StaticResource ValueContentStyle}" Text="未检测"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="versionName" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="VersionText" Style="{StaticResource ValueContentStyle}" Text="-"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="versionCode" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="VersionCodeText" Style="{StaticResource ValueContentStyle}" Text="-"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="备份结果" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="BackupStatusText" Style="{StaticResource ValueContentStyle}" Text="尚未备份"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="备份保存路径" Style="{StaticResource ValueTitleStyle}"/>
                                <TextBox x:Name="BackupPathTextBox"
                                         Margin="0,10,0,0"
                                         Height="42"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="无障碍状态" Style="{StaticResource CardTitle}"/>
                                    <Border x:Name="AccessibilityBadge"
                                            Style="{StaticResource Badge}"
                                            Background="#94A3B8"
                                            DockPanel.Dock="Right">
                                        <TextBlock x:Name="AccessibilityBadgeText"
                                                   Style="{StaticResource BadgeTextStyle}"
                                                   Text="未检测"/>
                                    </Border>
                                </DockPanel>
                                <UniformGrid Margin="0,18,0,0" Columns="2">
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="总开关" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="AccessibilityEnabledText" Style="{StaticResource ValueContentStyle}" Text="-"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="服务已加入" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="AccessibilityServiceText" Style="{StaticResource ValueContentStyle}" Text="-"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="备份文件大小" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="BackupSizeText" Style="{StaticResource ValueContentStyle}" Text="-"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,12">
                                        <TextBlock Text="SHA256" Style="{StaticResource ValueTitleStyle}"/>
                                        <TextBlock x:Name="BackupShaText" Style="{StaticResource ValueContentStyle}" Text="-" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="enabled_accessibility_services" Style="{StaticResource ValueTitleStyle}"/>
                                <TextBox x:Name="ServicesTextBox"
                                         Margin="0,10,0,0"
                                         Height="110"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="AppManagerView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Background="{StaticResource HeroBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AppSearchTextBox"
                                     Margin="0,0,12,0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AppSearchTextBox_TextChanged"/>
                            <Button Grid.Column="1"
                                    Margin="0"
                                    Content="刷新列表"
                                    Click="RefreshAppsButton_Click"/>
                            <Button Grid.Column="2"
                                    Margin="12,0,0,0"
                                    Background="#EAF2FF"
                                    Foreground="#1D4ED8"
                                    Content="全选"
                                    Click="SelectAllAppsButton_Click"/>
                            <Button Grid.Column="3"
                                    Margin="12,0,0,0"
                                    Background="#F4F7FB"
                                    Foreground="#344054"
                                    Content="取消全选"
                                    Click="ClearAppSelectionButton_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock Text="电视应用列表" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="AppCountText"
                                               DockPanel.Dock="Right"
                                               Style="{StaticResource MutedText}"
                                               Text="0 个应用"/>
                                </DockPanel>
                                <ListBox x:Name="AppListBox"
                                         Grid.Row="1"
                                         Margin="0,16,0,0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:AppInfo}">
                                            <Border Margin="0,0,0,10"
                                                    Padding="12"
                                                    Background="#FBFCFF"
                                                    BorderBrush="#E4E9F2"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42"/>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="126"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36"
                                                            Height="36"
                                                            Background="#DCEAFD"
                                                            CornerRadius="12"
                                                            VerticalAlignment="Top">
                                                        <Image Source="pack://application:,,,/SonyVolumeGuiKillerPcManager;component/Resources/ok.png" Stretch="Uniform" Margin="6"/>
                                                    </Border>
                                                    <CheckBox Grid.Column="1"
                                                              VerticalAlignment="Top"
                                                              Margin="6,4,0,0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                                    <StackPanel Grid.Column="2" Margin="8,0,12,0">
                                                        <TextBlock Text="{Binding AppLabel}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource InkBrush}"/>
                                                        <TextBlock Margin="0,4,0,0"
                                                                   Text="{Binding PackageName}"
                                                                   Style="{StaticResource MutedText}"/>
                                                        <TextBlock Margin="0,4,0,0"
                                                                   Text="{Binding ShortApkPath}"
                                                                   Style="{StaticResource MutedText}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Margin="0,6,0,0"
                                                                   Foreground="#475467"
                                                                   Text="{Binding VersionName, StringFormat=versionName: {0}}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            Background="#0891B2"
                                                            Tag="{Binding}"
                                                            Content="备份此应用"
                                                            Click="BackupSingleAppButton_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="应用管理" Style="{StaticResource CardTitle}"/>
                                <TextBlock Margin="0,10,0,0"
                                           Style="{StaticResource MutedText}"
                                           Text="支持电视端 APK 备份、本地 APK 安装和批量选择。"/>

                                <Button Margin="0,18,0,0"
                                        Style="{StaticResource ActionTealButton}"
                                        Click="BackupSelectedAppsButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7C3;" FontSize="16"/>
                                        <TextBlock Text="  备份选中应用"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource ActionGreenButton}"
                                        Click="InstallLocalApkButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE898;" FontSize="16"/>
                                        <TextBlock Text="  安装本地 APK"/>
                                    </StackPanel>
                                </Button>

                                <Button Background="#FFF2E8"
                                        Foreground="#C2410C"
                                        Click="HelpButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE897;" FontSize="16"/>
                                        <TextBlock Text="  说明"/>
                                    </StackPanel>
                                </Button>

                                <Border Margin="0,18,0,0"
                                        CornerRadius="14"
                                        Background="#F8FAFC"
                                        Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="最近操作"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"/>
                                        <TextBlock x:Name="AppManagerActionText"
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource MutedText}"
                                                   Text="尚未执行应用管理操作。"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock Text="运行日志" Style="{StaticResource CardTitle}"/>
                        <Button DockPanel.Dock="Right"
                                Padding="12,8"
                                Margin="0"
                                Background="#EAF2FF"
                                Foreground="#1D4ED8"
                                Click="ClearUiLogButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" FontSize="14"/>
                                <TextBlock Text="  清空界面"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <TextBox x:Name="LogTextBox"
                             Grid.Row="1"
                             Margin="0,16,0,0"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
